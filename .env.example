# ============================================================
# ACT 智能体自主委托支付 Demo — 环境配置
# ============================================================
#
# 使用方法：
#   1. 复制此文件为 .env
#   2. 只需修改下面"快速配置"中的 DEEPSEEK_API_KEY
#   3. 其余配置项均已有合理默认值，无需改动
#   4. 运行 python run_demo.py
#
# 获取 DeepSeek API Key：
#   访问 https://platform.deepseek.com/api_keys 注册并创建 API Key
#   DeepSeek 新用户通常有赠送额度，足够跑通 Demo
#
# ============================================================

# ============================================================
# 快速配置（只要改这里）
# ============================================================

# DeepSeek API Key（必填，其余 DeepSeek 配置沿用下面的默认值即可）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ============================================================
# 以下是完整配置项，一般无需修改
# ============================================================

# --- DeepSeek API ---
# 如果你有兼容 OpenAI 接口的其他 LLM（如通义千问、GLM 等），
# 也可以修改 BASE_URL 和 MODEL 来适配
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- 买方 / 卖方独立 LLM 配置（可选，留空则继承全局配置）---
BUYER_LLM_BASE_URL=
BUYER_LLM_API_KEY=
BUYER_LLM_MODEL=

SELLER_LLM_BASE_URL=
SELLER_LLM_API_KEY=
SELLER_LLM_MODEL=

# --- 服务地址（本地多进程通信，无需修改）---
DELEGATION_SERVICE_URL=http://127.0.0.1:8000
SELLER_AGENT_URL=http://127.0.0.1:8001
DEMO_PSP_URL=http://127.0.0.1:8002
TRUST_SERVICE_URL=http://127.0.0.1:8003

# --- 卖方智能体发现入口 ---
SELLER_AGENT_DESCRIPTION_URL=http://127.0.0.1:8001/.well-known/agent-card.json

# --- 委托授权默认参数 ---
DELEGATOR_ID=delegator_demo_001
DELEGATION_MODE=BOUNDED
MAX_TOTAL_AMOUNT=1.00
MAX_SINGLE_AMOUNT=0.50
CURRENCY=CNY
DELEGATION_VALIDITY_MINUTES=30

# --- 模拟子账户初始余额 ---
INITIAL_BALANCE=5.00

# --- 数据库路径（SQLite，自动创建，无需手动建库）---
DELEGATION_DB_PATH=./data/delegation_service.db
SELLER_DB_PATH=./data/seller.db
PSP_DB_PATH=./data/demo_psp.db
TRUST_DB_PATH=./data/trust_service.db
BUYER_DB_PATH=./data/buyer.db

# --- 日志级别 ---
LOG_LEVEL=INFO
